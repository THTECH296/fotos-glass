{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fotos",
  "version": "1.2.1",
  "identifier": "br.com.fotos.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "create": false,
        "title": "Fotos",
        "width": 1320,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "PortugueseBR"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "compression": "lzma"
      }
    },
    "publisher": "DevLumo",
    "homepage": "https://devlumo.com.br",
    "copyright": "© 2026 DevLumo. Todos os direitos reservados.",
    "category": "Photography",
    "shortDescription": "Suas fotos e vídeos no estilo do iPhone.",
    "longDescription": "Fotos é um visualizador de fotos e vídeos no estilo do app Fotos do iPhone para Windows, com álbuns, memórias, mapa, edição e Liquid Glass.",
    "licenseFile": "installer/termos.txt"
  }
}
