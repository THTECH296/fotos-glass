; Desfaz o registro de "app de fotos e vídeos" que o Fotos cria em HKCU (assoc.rs).
; Tira o valor do Fotos e, se a chave ficou vazia (sem subchaves e sem valores), a chave também:
; o assoc.rs cria .<ext>\OpenWithProgids mesmo quando não existia. Chaves com valores de outros
; apps (ou o padrão da extensão) ficam.
!macro FotosLimpaExt EXT PROG
  DeleteRegValue HKCU "Software\Classes\${EXT}\OpenWithProgids" "${PROG}"
  DeleteRegKey /ifnosubkeys /ifnovalues HKCU "Software\Classes\${EXT}\OpenWithProgids"
  DeleteRegKey /ifnosubkeys /ifnovalues HKCU "Software\Classes\${EXT}"
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  DeleteRegKey HKCU "Software\Classes\Fotos.Imagem"
  DeleteRegKey HKCU "Software\Classes\Fotos.Video"
  DeleteRegKey HKCU "Software\Classes\Applications\fotos.exe"
  DeleteRegKey HKCU "Software\Fotos"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Fotos"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Fotos Glass"
  !insertmacro FotosLimpaExt ".jpg" "Fotos.Imagem"
  !insertmacro FotosLimpaExt ".jpeg" "Fotos.Imagem"
  !insertmacro FotosLimpaExt ".jpe" "Fotos.Imagem"
