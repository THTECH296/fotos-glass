; Desfaz o registro de "app de fotos e vídeos" que o Fotos cria em HKCU (assoc.rs).
!macro NSIS_HOOK_POSTUNINSTALL
  DeleteRegKey HKCU "Software\Classes\Fotos.Imagem"
  DeleteRegKey HKCU "Software\Classes\Fotos.Video"
  DeleteRegKey HKCU "Software\Classes\Applications\fotos.exe"
  DeleteRegKey HKCU "Software\Fotos"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Fotos"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Fotos Glass"
  DeleteRegValue HKCU "Software\Classes\.jpg\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.jpeg\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.png\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.heic\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.heif\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.webp\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.gif\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.bmp\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.tif\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.tiff\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.avif\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.jxl\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.dng\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.cr2\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.cr3\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.nef\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.arw\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.raf\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.orf\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.rw2\OpenWithProgids" "Fotos.Imagem"
  DeleteRegValue HKCU "Software\Classes\.mp4\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.mov\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.m4v\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.avi\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.mkv\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.wmv\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.webm\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.3gp\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.mts\OpenWithProgids" "Fotos.Video"
  DeleteRegValue HKCU "Software\Classes\.m2ts\OpenWithProgids" "Fotos.Video"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
